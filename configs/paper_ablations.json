{
  "_description": "FINAL focused single-seed ablations (seed 0, PCHIP unless stated). Reference = tau_pchip_s0 / tau_linear_s0 from paper_main.json.",
  "global": {
    "db": "${dobi_db}",
    "images_root": "${coco_mini_person_d}/data/train2017/images",
    "eval_images_root": "${coco_mini_person_d}/data/test2017/images",
    "weights": "weights/yolov10n.pt",
    "save_strategy": "skip",
    "project": "${tau_behavior_models}/paper",
    "feature_cache": "${tau_behavior_models}/feature_cache",
    "class_id": 0,
    "iou_thr": 0.5,
    "u_max": 2.0,
    "imgsz": 640,
    "variants_per_subset_train": 7836,
    "variants_per_image_train": 0,
    "variants_per_subset_val": 0,
    "variants_per_image_val": 18,
    "smart_sampling": true,
    "batch_size": 64,
    "epochs": 60,
    "head_lr": 0.0001,
    "num_workers": 0,
    "split": "train",
    "use_val": true,
    "val_interval": 1,
    "patience": 1000,
    "hidden": 1024,
    "mlp_layers": 2,
    "seed": 0,
    "head": "tau_behavior",
    "interp": "pchip",
    "n_knots": 16,
    "knot_placement": "uniform",
    "fppi_space": "log1p",
    "n_tau_points": 201,
    "eval_args": {
      "threshold_eval": true,
      "skip_paired_pristine": true,
      "n_dense_tau": 1001,
      "seed": 0,
      "feature_cache": "${tau_behavior_models}/feature_cache"
    }
  },
  "runs": [
    {
      "name": "abl_pchip_K8_uniform",
      "n_knots": 8
    },
    {
      "name": "abl_pchip_K32_uniform",
      "n_knots": 32
    },
    {
      "name": "abl_pchip_K16_quantile_all",
      "knot_placement": "quantile",
      "knot_quantile_source": "all"
    },
    {
      "name": "abl_pchip_K16_quantile_tp",
      "knot_placement": "quantile",
      "knot_quantile_source": "tp"
    },
    {
      "name": "abl_pchip_K16_uniform_auxtau",
      "w_tau": 1.0,
      "tau_temperature": 0.02
    }
  ]
}